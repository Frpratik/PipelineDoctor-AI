# Copy this file to .env and fill in your values. Never commit .env.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-120b
# Optional fallback when Groq is rate limited. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
FALLBACK_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Postgres (also used by docker-compose.yml to create the database)
POSTGRES_USER=doctor
POSTGRES_PASSWORD=doctor
POSTGRES_DB=pipeline_doctor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
